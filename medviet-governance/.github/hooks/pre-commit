#!/bin/bash
set -u

# Pre-commit hook: chạy security checks trước khi commit.

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
VENV_BANDIT="$ROOT_DIR/.venv/bin/bandit"
VENV_PIP_AUDIT="$ROOT_DIR/.venv/bin/pip-audit"
REQ_FILE="$ROOT_DIR/medviet-governance/requirements.txt"

echo "Running security checks..."

if command -v git-secrets >/dev/null 2>&1; then
    git secrets --pre_commit_hook -- "$@"
    if [ $? -ne 0 ]; then
        echo "git-secrets found potential secrets. Commit blocked."
        exit 1
    fi
else
    echo "git-secrets not installed; using fallback secret scan."
    STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
    if [ -n "$STAGED_FILES" ]; then
        while IFS= read -r FILE; do
            [ -z "$FILE" ] && continue
            case "$FILE" in
                README.md|*.md|medviet-governance/*.md|medviet-governance/docs/*|medviet-governance/tests/*|PLAN.md|SKILL.md)
                    continue
                    ;;
                .venv/*|reports/*|data/raw/*)
                    continue
                    ;;
            esac
            if grep -Eq 'CCCD[:[:space:]]+[0-9]{12}|cccd[:[:space:]]+[0-9]{12}|password[[:space:]]*=[[:space:]]*["'"'"'][^"'"'"']+["'"'"']|secret_key[[:space:]]*=[[:space:]]*["'"'"'][^"'"'"']+["'"'"']' "$FILE"; then
                echo "Potential secret found in $FILE. Commit blocked."
                exit 1
            fi
        done <<EOF
$STAGED_FILES
EOF
    fi
fi

if [ -x "$VENV_BANDIT" ]; then
    BANDIT="$VENV_BANDIT"
else
    BANDIT="bandit"
fi

if [ -x "$VENV_PIP_AUDIT" ]; then
    PIP_AUDIT="$VENV_PIP_AUDIT"
else
    PIP_AUDIT="pip-audit"
fi

echo "Running Bandit SAST..."
"$BANDIT" -r "$ROOT_DIR/medviet-governance/src" -q
if [ $? -ne 0 ]; then
    echo "Bandit found security issues. Review above."
    exit 1
fi

echo "Checking dependencies for CVEs..."
if ! "$PIP_AUDIT" -r "$REQ_FILE" --no-deps --desc on; then
    echo "pip-audit could not complete in this environment; review reports/pip_audit_report.txt if available."
fi

echo "All security checks passed."
exit 0
